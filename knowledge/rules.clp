;;; ===========================================================
;;; ЛР 4. Продукційна база знань «Керування мікрокліматом теплиці»
;;; Культура: томат. Терміни — зі словника ЛР 3 (knowledge/glossary.md),
;;; посилання R*/E*/M* — на одиниці знань ЛР 2 (knowledge/units.md),
;;; V* — на винятки ЛР 3 (docs/lab03_model.md).
;;;
;;; Рівні пріоритету (salience):
;;;   10  — нормалізація: показники датчиків -> стани
;;;    5  — винятки-блокування: забороняють дію до того, як її рекомендовано
;;;    0  — основна логіка: стани -> рекомендації; немонотонні винятки
;;;  -10  — формування висновку й виведення
;;; ===========================================================

;;; ---------- ШАБЛОНИ ----------

;; Об'єкт керування: відсік теплиці та його поточні показники (ОАЗ: Відсік_А)
(deftemplate відсік
   (slot id (type SYMBOL))
   (slot фаза (type SYMBOL) (allowed-values розсада цвітіння плодоношення) (default плодоношення))
   (slot час_доби (type SYMBOL) (allowed-values ніч світанок день вечір) (default день))
   (slot температура (type NUMBER SYMBOL) (default невідомо))   ; °C
   (slot вологість (type NUMBER SYMBOL) (default невідомо))     ; %
   (slot год_вологість_понад_85 (type NUMBER) (default 0))      ; год
   (slot co2 (type NUMBER SYMBOL) (default невідомо))           ; ppm
   (slot швидкість_нагріву (type NUMBER) (default 0))           ; °C/год
   (slot кватирки (type SYMBOL) (allowed-values закриті привідкриті відкриті) (default закриті)))

;; Зовнішні умови (ОАЗ: Метеостанція_1)
(deftemplate погода
   (slot температура (type NUMBER) (default 15))   ; °C
   (slot вологість (type NUMBER) (default 60))     ; %
   (slot вітер (type NUMBER) (default 0))          ; м/с
   (slot дощ (type SYMBOL) (allowed-values так ні) (default ні)))

;; Довідкові знання: числові пороги з ЛР 2 (F*, С*, G*)
(deftemplate поріг
   (slot назва (type SYMBOL))
   (slot значення (type NUMBER)))

;; Спостереження / стан (Відхилення_мікроклімату, Симптом)
(deftemplate стан
   (slot відсік (type SYMBOL))
   (slot назва (type SYMBOL))
   (slot джерело (type SYMBOL) (allowed-values датчик користувач виведення) (default виведення)))

;; Дія, яку пропонує система (Керуюча_дія)
(deftemplate рекомендація
   (slot відсік (type SYMBOL))
   (slot дія (type SYMBOL))
   (slot причина (type SYMBOL))
   (slot режим (type SYMBOL) (allowed-values негайно плавно короткочасно) (default негайно))
   (slot правило (type SYMBOL)))

;; Заборона дії (для винятків)
(deftemplate блок
   (slot відсік (type SYMBOL))
   (slot дія (type SYMBOL))
   (slot для_стану (type SYMBOL) (default будь-який))
   (slot причина (type SYMBOL)))

;; Висновок, що потребує уваги людини
(deftemplate тривога
   (slot відсік (type SYMBOL))
   (slot рівень (type SYMBOL) (allowed-values увага критично))
   (slot повідомлення (type STRING)))

;;; ---------- ДОВІДКОВІ ФАКТИ ----------

(deffacts пороги
   (поріг (назва відкриття_кватирок) (значення 24))       ; R1, рішення С5
   (поріг (назва перегрів) (значення 29))                 ; O1, F6
   (поріг (назва критичний_перегрів) (значення 33))       ; F5, рішення С2
   (поріг (назва переохолодження) (значення 15))          ; F2, R4, рішення С3
   (поріг (назва критичне_переохолодження) (значення 10)) ; F5, рішення С3
   (поріг (назва висока_нічна_t) (значення 21))           ; F6, R5
   (поріг (назва вологість_макс) (значення 85))           ; F10, R6
   (поріг (назва вологість_цвітіння) (значення 70))       ; F9, рішення С1
   (поріг (назва вологість_мін) (значення 55))            ; R9
   (поріг (назва вологість_гниль) (значення 93))          ; F11
   (поріг (назва co2_мін) (значення 800))                 ; R10, рішення С4
   (поріг (назва швидкість_нагріву_макс) (значення 2))    ; E4, припущення G4
   (поріг (назва холодно_надворі) (значення 10))          ; R7, припущення
   (поріг (назва спекотно_надворі) (значення 28))         ; E1, припущення
   (поріг (назва волого_надворі) (значення 70))           ; E1, припущення
   (поріг (назва вітер_макс) (значення 10)))              ; G2, припущення

;;; ===========================================================
;;; РІВЕНЬ 10 — НОРМАЛІЗАЦІЯ: показники -> стани
;;; ===========================================================

(defrule бракує-температури
   "Неповні дані: без температури температурні правила не застосовуються"
   (declare (salience 10))
   (відсік (id ?id) (температура невідомо))
   =>
   (assert (стан (відсік ?id) (назва бракує_даних_температури))))

(defrule стан-перегрів
   (declare (salience 10))
   (поріг (назва перегрів) (значення ?lim))
   (відсік (id ?id) (температура ?t&:(numberp ?t)&:(> ?t ?lim)))
   =>
   (assert (стан (відсік ?id) (назва перегрів) (джерело датчик))))

(defrule стан-критичний-перегрів
   (declare (salience 10))
   (поріг (назва критичний_перегрів) (значення ?lim))
   (відсік (id ?id) (температура ?t&:(numberp ?t)&:(> ?t ?lim)))
   =>
   (assert (стан (відсік ?id) (назва критичний_перегрів) (джерело датчик))))

(defrule стан-переохолодження
   "Після перевірки на неповноту — будь-якої пори доби, не лише вночі"
   (declare (salience 10))
   (поріг (назва переохолодження) (значення ?lim))
   (відсік (id ?id) (температура ?t&:(numberp ?t)&:(< ?t ?lim)))
   =>
   (assert (стан (відсік ?id) (назва переохолодження) (джерело датчик))))

(defrule стан-критичне-переохолодження
   (declare (salience 10))
   (поріг (назва критичне_переохолодження) (значення ?lim))
   (відсік (id ?id) (температура ?t&:(numberp ?t)&:(< ?t ?lim)))
   =>
   (assert (стан (відсік ?id) (назва критичне_переохолодження) (джерело датчик))))

(defrule стан-висока-нічна-температура
   (declare (salience 10))
   (поріг (назва висока_нічна_t) (значення ?lim))
   (відсік (id ?id) (час_доби ніч) (температура ?t&:(numberp ?t)&:(> ?t ?lim)))
   =>
   (assert (стан (відсік ?id) (назва висока_нічна_температура) (джерело датчик))))

(defrule стан-надмірна-вологість
   "RH > 85 % довше 1 год (рішення G1)"
   (declare (salience 10))
   (поріг (назва вологість_макс) (значення ?lim))
   (відсік (id ?id) (вологість ?h&:(numberp ?h)&:(> ?h ?lim))
           (год_вологість_понад_85 ?d&:(>= ?d 1)))
   =>
   (assert (стан (відсік ?id) (назва надмірна_вологість) (джерело датчик))))

(defrule стан-вологість-у-цвітінні
   "У фазі цвітіння цільова межа вологості 70 % (рішення С1)"
   (declare (salience 10))
   (поріг (назва вологість_цвітіння) (значення ?lim))
   (відсік (id ?id) (фаза цвітіння) (вологість ?h&:(numberp ?h)&:(> ?h ?lim)))
   =>
   (assert (стан (відсік ?id) (назва вологість_вища_для_запилення) (джерело датчик))))

(defrule стан-недостатня-вологість
   (declare (salience 10))
   (поріг (назва вологість_мін) (значення ?lim))
   (відсік (id ?id) (час_доби день) (вологість ?h&:(numberp ?h)&:(< ?h ?lim)))
   =>
   (assert (стан (відсік ?id) (назва недостатня_вологість) (джерело датчик))))

(defrule стан-дефіцит-co2
   (declare (salience 10))
   (поріг (назва co2_мін) (значення ?lim))
   (відсік (id ?id) (час_доби день) (кватирки закриті) (co2 ?c&:(numberp ?c)&:(< ?c ?lim)))
   =>
   (assert (стан (відсік ?id) (назва дефіцит_co2) (джерело датчик))))

(defrule стан-різке-підвищення-температури
   (declare (salience 10))
   (поріг (назва швидкість_нагріву_макс) (значення ?lim))
   (відсік (id ?id) (швидкість_нагріву ?v&:(> ?v ?lim)))
   =>
   (assert (стан (відсік ?id) (назва різке_підвищення_температури) (джерело датчик))))

(defrule стан-холодно-надворі
   (declare (salience 10))
   (поріг (назва холодно_надворі) (значення ?lim))
   (погода (температура ?t&:(< ?t ?lim)))
   (відсік (id ?id))
   =>
   (assert (стан (відсік ?id) (назва холодно_надворі) (джерело датчик))))

(defrule стан-спекотний-вологий-день
   "E1: «спекотний вологий день» розбито на дві атомарні умови (ЛР 3)"
   (declare (salience 10))
   (поріг (назва спекотно_надворі) (значення ?t0))
   (поріг (назва волого_надворі) (значення ?h0))
   (погода (температура ?t&:(> ?t ?t0)) (вологість ?h&:(> ?h ?h0)))
   (відсік (id ?id))
   =>
   (assert (стан (відсік ?id) (назва спекотний_вологий_день) (джерело датчик))))

;;; ===========================================================
;;; РІВЕНЬ 5 — ВИНЯТКИ-БЛОКУВАННЯ (пріоритет правил, ЛР 3)
;;; ===========================================================

(defrule V1-без-випарного-охолодження
   "E1/V1: у спекотний вологий день або за надмірної вологості
    випарне охолодження лише додає вологу"
   (declare (salience 5))
   (стан (відсік ?id) (назва спекотний_вологий_день|надмірна_вологість))
   =>
   (assert (блок (відсік ?id) (дія випарне_охолодження) (причина підвищує_вологість))))

(defrule V2-не-провітрювати-від-вологи-в-холод
   "R7/E3/V2: у холод вологість знижують не провітрюванням, а циклом
    нагріву й провітрювання; блок лише для причини «вологість»"
   (declare (salience 5))
   (стан (відсік ?id) (назва надмірна_вологість))
   (стан (відсік ?id) (назва холодно_надворі))
   =>
   (assert (блок (відсік ?id) (дія провітрювання) (для_стану надмірна_вологість)
                 (причина холодно_надворі))))

(defrule блок-провітрювання-дощ-вітер
   "Усунення неповноти G2 (припущення): у дощ або сильний вітер кватирки не відкривати"
   (declare (salience 5))
   (поріг (назва вітер_макс) (значення ?lim))
   (or (погода (дощ так))
       (погода (вітер ?w&:(> ?w ?lim))))
   (відсік (id ?id))
   =>
   (assert (блок (відсік ?id) (дія провітрювання) (причина дощ_або_вітер))))

;;; ===========================================================
;;; РІВЕНЬ 0 — ОСНОВНА ЛОГІКА: стани -> рекомендації
;;; ===========================================================

(defrule R1-провітрювання-вище-24
   "R1: цвітіння–плодоношення, t > 24 °C, кватирки ще не відкриті"
   (поріг (назва відкриття_кватирок) (значення ?lim))
   (відсік (id ?id) (фаза цвітіння|плодоношення) (кватирки закриті|привідкриті)
           (температура ?t&:(numberp ?t)&:(> ?t ?lim)))
   (not (блок (відсік ?id) (дія провітрювання) (для_стану будь-який)))
   (not (рекомендація (відсік ?id) (дія провітрювання)))
   =>
   (assert (рекомендація (відсік ?id) (дія провітрювання) (причина перегрів) (правило R1))))

(defrule R2-затінення-при-відкритих-кватирках
   "R2: перегрів, хоча кватирки вже відкриті"
   (стан (відсік ?id) (назва перегрів))
   (відсік (id ?id) (кватирки відкриті))
   (not (рекомендація (відсік ?id) (дія затінення)))
   =>
   (assert (рекомендація (відсік ?id) (дія затінення) (причина перегрів) (правило R2))))

(defrule R2a-затінення-коли-провітрювати-не-можна
   "Перегрів, а провітрювання заблоковане (дощ, вітер) — лишається затінення"
   (стан (відсік ?id) (назва перегрів))
   (блок (відсік ?id) (дія провітрювання) (для_стану будь-який))
   (not (рекомендація (відсік ?id) (дія затінення)))
   =>
   (assert (рекомендація (відсік ?id) (дія затінення) (причина перегрів) (правило R2a))))

(defrule R3-затінення-при-сонячному-опіку
   "R3: «надмірна освітленість» без числового порогу (G3) —
    спрацьовує лише за спостереженням користувача"
   (стан (відсік ?id) (назва сонячний_опік) (джерело користувач))
   (not (рекомендація (відсік ?id) (дія затінення)))
   =>
   (assert (рекомендація (відсік ?id) (дія затінення) (причина надмірна_освітленість) (правило R3))))

(defrule випарне-охолодження-при-перегріві
   "Д1: активне охолодження при перегріві (якщо не заблоковане винятком V1)"
   (стан (відсік ?id) (назва перегрів))
   (not (блок (відсік ?id) (дія випарне_охолодження)))
   (not (рекомендація (відсік ?id) (дія випарне_охолодження)))
   =>
   (assert (рекомендація (відсік ?id) (дія випарне_охолодження) (причина перегрів) (правило Д1))))

(defrule R4-обігрів
   (стан (відсік ?id) (назва переохолодження))
   (not (рекомендація (відсік ?id) (дія обігрів)))
   =>
   (assert (рекомендація (відсік ?id) (дія обігрів) (причина переохолодження) (правило R4))))

(defrule R5-провітрювання-теплої-ночі
   (стан (відсік ?id) (назва висока_нічна_температура))
   (not (блок (відсік ?id) (дія провітрювання) (для_стану будь-який)))
   (not (рекомендація (відсік ?id) (дія провітрювання)))
   =>
   (assert (рекомендація (відсік ?id) (дія провітрювання) (причина висока_нічна_температура) (правило R5))))

(defrule R6-провітрювання-від-вологи
   "R6: загальне правило; перекривається винятком V2"
   (стан (відсік ?id) (назва надмірна_вологість))
   (not (блок (відсік ?id) (дія провітрювання) (для_стану надмірна_вологість|будь-який)))
   (not (рекомендація (відсік ?id) (дія провітрювання)))
   =>
   (assert (рекомендація (відсік ?id) (дія провітрювання) (причина надмірна_вологість) (правило R6))))

(defrule R7-8-цикл-нагріву-й-провітрювання
   "R7 + R8 (об'єднані після перевірки на надлишковість):
    волого І (холодно надворі АБО вечір/світанок)"
   (стан (відсік ?id) (назва надмірна_вологість))
   (or (стан (відсік ?id) (назва холодно_надворі))
       (відсік (id ?id) (час_доби вечір|світанок)))
   (not (рекомендація (відсік ?id) (дія цикл_нагріву_й_провітрювання)))
   =>
   (assert (рекомендація (відсік ?id) (дія цикл_нагріву_й_провітрювання)
                         (причина надмірна_вологість) (правило R7_R8))))

(defrule E3-циркуляція-в-закритій-теплиці
   "E3: провітрювати від вологи не можна — вологу на листі знімає циркуляція"
   (блок (відсік ?id) (дія провітрювання) (для_стану надмірна_вологість))
   (not (рекомендація (відсік ?id) (дія циркуляція_повітря)))
   =>
   (assert (рекомендація (відсік ?id) (дія циркуляція_повітря) (причина надмірна_вологість) (правило E3))))

(defrule циркуляція-при-конденсаті
   (стан (відсік ?id) (назва конденсат_на_листі))
   (not (рекомендація (відсік ?id) (дія циркуляція_повітря)))
   =>
   (assert (рекомендація (відсік ?id) (дія циркуляція_повітря) (причина конденсат_на_листі) (правило E3))))

(defrule ризик-сірої-гнилі
   "F11: RH >= 93 % — умова розвитку сірої гнилі"
   (поріг (назва вологість_гниль) (значення ?lim))
   (відсік (id ?id) (вологість ?h&:(numberp ?h)&:(>= ?h ?lim)))
   =>
   (assert (тривога (відсік ?id) (рівень увага)
                    (повідомлення "Вологість >= 93 %: ризик сірої гнилі"))))

(defrule провітрювання-у-цвітінні
   "С1: у цвітінні вологість понад 70 % погіршує запилення"
   (стан (відсік ?id) (назва вологість_вища_для_запилення))
   (not (блок (відсік ?id) (дія провітрювання)))
   (not (рекомендація (відсік ?id) (дія провітрювання)))
   =>
   (assert (рекомендація (відсік ?id) (дія провітрювання) (причина вологість_вища_для_запилення) (правило С1))))

(defrule R9-зволоження
   (стан (відсік ?id) (назва недостатня_вологість))
   (not (рекомендація (відсік ?id) (дія зволоження)))
   =>
   (assert (рекомендація (відсік ?id) (дія зволоження) (причина недостатня_вологість) (правило R9))))

(defrule R10-подача-co2
   "R10 (+ R11: стан дефіцит_co2 визначено лише вдень)"
   (стан (відсік ?id) (назва дефіцит_co2))
   (not (рекомендація (відсік ?id) (дія провітрювання)))
   (not (рекомендація (відсік ?id) (дія подача_co2)))
   =>
   (assert (рекомендація (відсік ?id) (дія подача_co2) (причина дефіцит_co2) (правило R10))))

(defrule R12-плавне-підвищення-уставки
   "R12: з 03:00 до світанку температуру піднімають поступово"
   (відсік (id ?id) (час_доби світанок))
   (not (рекомендація (відсік ?id) (дія плавне_підвищення_уставки)))
   =>
   (assert (рекомендація (відсік ?id) (дія плавне_підвищення_уставки) (причина світанок) (правило R12))))

(defrule E4-обмежити-швидкість-нагріву
   "E4: різке підвищення температури спричиняє мікротріщини плодів"
   (стан (відсік ?id) (назва різке_підвищення_температури))
   (not (рекомендація (відсік ?id) (дія плавне_підвищення_уставки)))
   =>
   (assert (рекомендація (відсік ?id) (дія плавне_підвищення_уставки)
                         (причина різке_підвищення_температури) (правило E4))))

(defrule тривога-критичний-перегрів
   "Прогалина ЛР 3: для критичних станів не було жодної дії"
   (стан (відсік ?id) (назва критичний_перегрів))
   =>
   (assert (тривога (відсік ?id) (рівень критично)
                    (повідомлення "Температура > 33 °C: ризик опадання квіток"))))

(defrule тривога-критичне-переохолодження
   (стан (відсік ?id) (назва критичне_переохолодження))
   =>
   (assert (тривога (відсік ?id) (рівень критично)
                    (повідомлення "Температура < 10 °C: ризик опадання квіток"))))

;;; ---------- Немонотонні винятки та значення за замовчуванням ----------

(defrule V3-обігрів-плавно
   "V3: дії типово виконуються негайно, але обігрів — плавно (E4),
    окрім критичного переохолодження. Умова (режим негайно) не дає циклу"
   ?r <- (рекомендація (відсік ?id) (дія обігрів) (режим негайно))
   (not (стан (відсік ?id) (назва критичне_переохолодження)))
   =>
   (modify ?r (режим плавно)))

(defrule E2-короткочасне-провітрювання-вранці
   "E2: сонце вже гріє, а надворі холодно — провітрювати лише коротко"
   ?r <- (рекомендація (відсік ?id) (дія провітрювання) (режим негайно))
   (відсік (id ?id) (час_доби світанок))
   (стан (відсік ?id) (назва холодно_надворі))
   =>
   (modify ?r (режим короткочасно)))

(defrule V4-скасувати-co2-при-провітрюванні
   "V4 (немонотонна логіка): новий висновок «провітрювати» скасовує
    раніше зроблений висновок «подавати CO2» (несумісні дії)"
   (рекомендація (відсік ?id) (дія провітрювання))
   ?c <- (рекомендація (відсік ?id) (дія подача_co2))
   =>
   (retract ?c)
   (printout t "  [V4] " ?id ": подачу CO2 скасовано — кватирки буде відкрито" crlf))

;;; ===========================================================
;;; РІВЕНЬ -10 — ФОРМУВАННЯ ВИСНОВКУ
;;; ===========================================================

(defrule вивід-тривоги
   (declare (salience -10))
   (тривога (відсік ?id) (рівень ?l) (повідомлення ?m))
   =>
   (printout t "  ТРИВОГА [" ?l "] " ?id ": " ?m crlf))

(defrule вивід-рекомендації
   (declare (salience -10))
   (рекомендація (відсік ?id) (дія ?d) (причина ?c) (режим ?m) (правило ?r))
   =>
   (printout t "  " ?id ": " ?d " (" ?m ") — причина: " ?c ", правило " ?r crlf))

(defrule вивід-бракує-даних
   (declare (salience -10))
   (стан (відсік ?id) (назва бракує_даних_температури))
   =>
   (printout t "  " ?id ": бракує даних про температуру — температурні висновки не робляться" crlf))

(defrule вивід-норма
   (declare (salience -10))
   (відсік (id ?id))
   (not (рекомендація (відсік ?id)))
   (not (тривога (відсік ?id)))
   (not (стан (відсік ?id) (назва бракує_даних_температури)))
   =>
   (printout t "  " ?id ": мікроклімат у нормі, дії не потрібні" crlf))
